# Google Cloud Text-to-Speech -- path to the service-account JSON.
# Alternatively put the JSON as a [gcp_service_account] table in .streamlit/secrets.toml
GOOGLE_APPLICATION_CREDENTIALS=

# Gemini (Google AI Studio key) -- free tier ~1500 req/day on Flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Stock background video providers (both free)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional explicit binary paths; leave blank to auto-detect
FFMPEG_PATH=
FFPROBE_PATH=

# Target narration budget in seconds (45-60s video)
DURATION_BUDGET_S=50
